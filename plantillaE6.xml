<?xml version="1.0" encoding="utf-8"?>
<xml>
	<!--  ════════════════════════════════════════════════════════════════
         COLECCIÓN PRINCIPAL — entry-point
         Itera sobre los ítems; cada uno ocupa una página
         ════════════════════════════════════════════════════════════════  -->
	<coll name="collItems" sql="
		  SELECT 
			go.NUMERO_OBRA, 
			go.COD_UBICACION,
			gut.UBICACION_PADRE,
			'[Pendiente Duda] Obra civil / S3020 / S3020-M014K / Celda 2L2p-R0618332' AS JERARQUIA_N1, 
			gut.DESC_UBICACION,
			CONCAT(DATE_FORMAT(go.FECHA_INICIO, '%d-%m-%y'),' / ',DATE_FORMAT(go.FECHA_FIN,'%d-%m-%Y')) as FECHAS,		  
		   '{{MONITOR_PATH}}ide_iberdrola.png' AS MAP_LOGO
			FROM gen_obra go
			INNER JOIN gen_uts_ubicaciontecnica gut ON gut.COD_UBICACION = go.COD_UBICACION" filter="go.id=##ID##" entry-point="true" show-header="false" lmargin="5%" rmargin="5%" tmargin="3%" bmargin="5%">
		<!--  ── CABECERA (se repite en todas las páginas) ───────────────  -->
		<frame name="frmCabecera" width="100%" height="68p" copy-to-all-pages="true">
			<!--  Borde izquierdo verde  -->
			<frame name="frmBordeVerde" width="1%" height="68p" bgcolor="#4a7c2f">
			</frame>
			<!--  RESUMEN DE LA OBRA + número  -->
			<frame name="frmDatosHeader" newline="false" height="56p" width="96%" lmargin="3%">
				<frame name="frmDatosObra" width="36%" height="40p" newline="false">
					<prop name="DESCRIPCION_TL" type="TL" title="RESUMEN DE LA OBRA" width="100%" font-size="10" lines="1" forecolor="#777777"/>
					<prop name="NUMERO_OBRA" type="T" width="100%" font-size="16" fontbold="true" lines="1"/>
				</frame>
				<!--  Ubicación técnica + fechas  -->
				<frame name="frmUbicacion" width="38%" height="40p" newline="false">
					<prop name="DESC_UBICACION" type="T" width="100%" font-size="16" fontbold="true" lines="1"/>
					<prop name="FECHAS" type="T" width="100%" font-size="10" forecolor="#555555" lines="1"/>
				</frame>
				<!--  Logo i-DE  -->
				<frame name="frmLogo" width="23%" height="40p" newline="false" align="right">
					<prop name="MAP_LOGO" type="IMG" width="95%" height="58p" keep-aspect-ratio="true" align="right"/>
				</frame>
				<!--  Línea + jerarquía  -->
				<divider width="100%" tmargin="2p"/>
				<frame name="frmJerarquia" width="100%" height="16p" tmargin="10p">
					<prop name="JERARQUIA_N1" type="T" width="100%" font-size="10" forecolor="#444444" fontbold="true" lines="1"/>
				</frame>
			</frame>
		</frame>

		<!--  Lista de observaciones (verificador / contratista)  -->
		<prop name="@items" content="items" type="Z" tmargin="10p"/>
		<content name="items" src="items" filter="OEI.NUMERO_OBRA = ##FLD_NUMERO_OBRA## GROUP BY COD_PPI_ITEM ORDER BY COD_PPI_ITEM"/>
		
		<footer height="28p">
			<divider width="100%"/>
			<prop name="PIE_IZQUIERDA" type="T" width="80%" font-size="10"  lines="1"  tmargin="10p" fontbold="true"/>
			<prop name="PAGE" type="TL" title="PÁG. ##PAGE## / ##TOTAL_PAGES##" width="20%" font-size="10" fontbold="true" align="right" lines="1" newline="false"  tmargin="10p"/>
		</footer>
	</coll>

	<coll name="items" sql="SELECT
    COD_PPI_ITEM,
    CAST(CONCAT('Item ', ROW_NUMBER() OVER (ORDER BY COD_PPI_ITEM)) AS VARCHAR(255))  AS TITULO_ITEM
FROM gen_obra_ppi_equipos_inspeccion OEI" show-header="false" >


		<frame name="frmObsTitulo" width="100%" height="22p" tmargin="20p">
			<frame name="frmBordeVerde" width="1%" height="22p" bgcolor="#A0BF8B">
			</frame>
			<prop name="TITULO_ITEM" type="T" width="96%" height="22p" font-size="10" fontbold="true" lines="1" lmargin="3%" newline="false" align="center|left"/>
		</frame>

		<prop name="TITULO_ITEM" type="TL" title="&#183; Equipos de medida" width="96%" height="22p" font-size="10" fontbold="true" lines="1" lmargin="3%" align="center|left"/>					
		<!--  ── CABECERA COLUMNAS CONTRATISTA / VERIFICADOR ─────────────  -->
		<frame name="frmPICols" width="100%" height="24p" bgcolor="#bdd5b1" tmargin="10p">
			<!--  columna etiqueta vacía  -->
			<prop name="LBL_TIPO_EQUIPO" type="TL" title="Tipo de equipo" width="32%" height="24p" font-size="10" fontbold="true" lmargin="2%" lines="1" align="center|left" newline="false"/>
			<prop name="LBL_FAB_MOD" type="TL" title="Fabricante/Modelo" width="33%" font-size="10" height="24p" fontbold="true" lines="1" align="center|left" newline="false"/>
			<prop name="LBL_NUM_SERIE" type="TL" title="Núm. serie" width="33%" font-size="10" height="24p" fontbold="true" lines="1" align="center|left" newline="false"/>
		</frame>

		<!--  Lista de observaciones (verificador / contratista)  -->
		<prop name="@equipos" content="equipos" type="Z" />
		<content name="equipos" src="equipos" filter="OEI.COD_PPI_ITEM = '##FLD_COD_PPI_ITEM##'"/>		
		
		<!--  Salto de página entre ítems  -->
		<break-page></break-page>
		
	</coll>


	<coll name="equipos" sql="SELECT   
	COD_PPI_ITEM,
    OEI.DEN_TIPO AS TIPO_EQ,              
    CONCAT(OEI.FABRICANTE,'/',OEI.MODELO) AS FAB_MOD,
   OEI.NUM_SERIE AS NUM_SE
FROM gen_obra_ppi_equipos_inspeccion OEI"
		  xxxfilter="o.REVISION_ID=##FLD_ID##" show-header="false" cell-odd-bgcolor="#f5f8f3">
		<frame name="frmGeneral" width="96%" tmargin="1%" bmargin="1%" lmargin="2%" rmargin="2%" >
			<prop name="TIPO_EQ" type="T" width="34%" font-size="10" lines="1" forecolor="#555555"/>
			<prop name="FAB_MOD" type="T" width="33%" font-size="10" lines="-1" allow-line-breaks="true" newline="false"/>
			<prop name="NUM_SE" type="T" width="33%" font-size="10" lines="-1" allow-line-breaks="true" newline="false"/>
		</frame>
	</coll>
</xml>