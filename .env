# Claves comunes a todos los entornos.
# Los valores admiten {{...}} anidado, resuelto por build.py.
# Sobrescribe cualquiera de estas claves en .env.<entorno>.

# Estructura de rutas del servidor. La barra final va DENTRO del valor,
# igual que hace ##GP_MONITORPATH## en runtime, para que el uso quede
# {{MONITOR_PATH}}ide_iberdrola.png
MONITOR_PATH=/var/www/vhosts/{{VHOST}}/core/xonemonitorcore/Monitor/
REPOSITORY_PATH=/var/www/vhosts/{{VHOST}}/xonerepository/
REPLICA_FILES={{REPOSITORY_PATH}}ReplicaFiles/{{REPLICA_CODE}}/
