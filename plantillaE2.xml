<?xml version="1.0" encoding="utf-8"?>
<xml>
	<!--  ════════════════════════════════════════════════════════════════
         COLECCIÓN PRINCIPAL — entry-point
         [Esc.1] Cabecera + pie  |  [Esc.2] Tabla datos PPI
         ════════════════════════════════════════════════════════════════  -->
	<coll name="collPPI" sql="SELECT 
			go.NUMERO_OBRA, 
			go.COD_UBICACION,
			gut.UBICACION_PADRE,
			'[Pendiente Duda] Obra civil / S3020 / S3020-M014K / Celda 2L2p-R0618332' AS JERARQUIA_N1, 
			gut.DESC_UBICACION,
			CONCAT(DATE_FORMAT(go.FECHA_INICIO, '%d-%m-%y'),' / ',DATE_FORMAT(go.FECHA_FIN,'%d-%m-%Y')) as FECHAS,		  
		   '/var/www/vhosts/xoneideintcore.com/core/xonemonitorcore/Monitor/ide_iberdrola.png' AS MAP_LOGO
			FROM gen_obra go
			INNER JOIN gen_uts_ubicaciontecnica gut ON gut.COD_UBICACION = go.COD_UBICACION" filter="go.id=##ID##" entry-point="true" show-header="false" lmargin="5%" rmargin="5%" tmargin="3%" bmargin="5%">
		<!--  ── CABECERA (se repite en todas las páginas) ───────────────  -->
		<frame name="frmCabecera" width="100%" height="68p" copy-to-all-pages="true">
			<!--  Borde izquierdo verde  -->
			<frame name="frmBordeVerde" width="1%" height="68p" bgcolor="#4a7c2f">
			</frame>
			<!--  RESUMEN DE LA OBRA + número  -->
			<frame name="frmDatosHeader" newline="false" height="56p" width="96%" lmargin="3%">
				<frame name="frmDatosObra" width="36%" height="40p" newline="false">
					<prop name="DESCRIPCION_TL" type="TL" title="RESUMEN DE LA OBRA" width="100%" font-size="10" lines="1" forecolor="#777777"/>
					<prop name="NUMERO_OBRA" type="T" width="100%" font-size="16" fontbold="true" lines="1"/>
				</frame>
				<!--  Ubicación técnica + fechas  -->
				<frame name="frmUbicacion" width="38%" height="40p" newline="false">
					<prop name="DESC_UBICACION" type="T" width="100%" font-size="16" fontbold="true" lines="1"/>
					<prop name="FECHAS" type="T" width="100%" font-size="10" forecolor="#555555" lines="1"/>
				</frame>
				<!--  Logo i-DE  -->
				<frame name="frmLogo" width="23%" height="40p" newline="false" align="right">
					<prop name="MAP_LOGO" type="IMG" width="95%" height="58p" keep-aspect-ratio="true" align="right"/>
				</frame>
				<!--  Línea + jerarquía  -->
				<divider width="100%" tmargin="2p"/>
				<frame name="frmJerarquia" width="100%" height="16p" tmargin="10p">
					<prop name="JERARQUIA_N1" type="T" width="100%" font-size="10" forecolor="#444444" fontbold="true" lines="1"/>
				</frame>
			</frame>			
		</frame>

		<prop name="@Cabecera" content="Cabecera" type="Z" tmargin="10p"/>
		<content name="Cabecera" src="Cabecera" filter="mppic.CLASE_OBJETO = 'DS_INT' AND gopc.NUMERO_OBRA = ##FLD_NUMERO_OBRA##"/>
		
		<!--  ── PIE DE PÁGINA (se repite en todas las páginas) ──────────  -->
		<!--  floating + top son atributos de <prop> (pie anclado al fondo)  -->
		
		<footer height="28p">
			<divider width="100%"/>
			<prop name="PIE_IZQUIERDA" type="T" width="80%" font-size="10"  lines="1"  tmargin="10p" fontbold="true"/>
			<prop name="PAGE" type="TL" title="PÁG. ##PAGE## / ##TOTAL_PAGES##" width="20%" font-size="10" fontbold="true" align="right" lines="1" newline="false"  tmargin="10p"/>
		</footer>
		
		
	</coll>


	<coll name="Cabecera" sql="SELECT 
			gopc.ID,
			gopc.NUMERO_OBRA,
			gopc.COD_PPI_CABECERA,
			mppic.COD_DOCUMENTO,
			mppic.ACTIVIDAD AS ACTIVIDAD_VALOR,
			mppic.DESCRIPCION AS DESCRIPCION_VALOR,
			utseq.COD_UBICACION_SAP AS SISTEMA_VALOR,
			utseq.DESC_EQUIPO AS DENOM_UBICACION_VALOR,
			utseq.TIPO AS DENOM_TIPO_VALOR,
			utseq.ANYO_CONSTRUCCION AS ANIO_FABRICACION_VALOR
			FROM gen_obra_ppi_cabecera gopc 
			INNER JOIN gen_maestro_obra_tipo_ppi_cabecera mppic ON mppic.COD_TIPO_PPI_CABECERA = gopc.COD_TIPO_PPI_CABECERA
			INNER JOIN gen_uts_ubicaciontecnica gut ON gut.COD_UBICACION = gopc.COD_UBICACION 
			left JOIN gen_uts_equipo utseq ON utseq.COD_EQUIPO = gopc.COD_EQUIPO
		  "
		  show-header="false">


		<!--  ── TABLA DATOS GENERALES DEL PPI ───────────────────────────  -->
		<!--  Cabecera verde con nombre del PPI  -->
		<frame name="frmPPITitulo" width="100%" height="28p" tmargin="16p" bgcolor="#bdd5b1">
			<prop name="COD_DOCUMENTO" type="T" width="92%" height="28p" font-size="13" fontbold="true" lines="1" lmargin="4%" align="center|left"/>
		</frame>
		<!--  Filas etiqueta / valor, fondo alternado  -->
		<frame name="frmRowActividad" width="100%" height="28p">
			<prop name="ACTIVIDAD" type="TL" title="Actividad" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="ACTIVIDAD_VALOR" type="T" title="Actividad" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>
		<frame name="frmRowDescripcion" width="100%" height="28p" bgcolor="#f5f8f3" >
			<prop name="DESCRIPCION" type="TL" title="Descripción" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="DESCRIPCION_VALOR" type="T" title="Descripción" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>
		<frame name="frmRowSistema" width="100%" height="28p" >
			<prop name="SISTEMA" type="TL" title="Sistema" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="SISTEMA_VALOR" type="T" title="Sistema" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>
		<frame name="frmRowDenomUbic" width="100%" height="28p" bgcolor="#f5f8f3" >
			<prop name="DENOM_UBICACION" type="TL" title="Denominación ubicación" height="28p" width="49%" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="DENOM_UBICACION_VALOR" type="T" title="Denominación ubicación" height="28p" width="49%" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>
		<frame name="frmRowDenomTipo" width="100%" height="28p" >
			<prop name="DENOM_TIPO" type="TL" title="Denominación tipo" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="DENOM_TIPO_VALOR" type="T" title="Denominación tipo" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>
		<frame name="frmRowAnio" width="100%" height="28p" bgcolor="#f5f8f3" >
			<prop name="ANIO_FABRICACION" type="TL" title="Año fabricación" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="ANIO_FABRICACION_VALOR" type="T" title="Año fabricación" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>
		<!--  ── OBSERVACIONES GENERALES ─────────────────────────────────  -->
		<frame name="frmObsTitulo" width="100%" height="22p" tmargin="20p">
			<frame name="frmBordeVerde" width="1%" height="22p" bgcolor="#A0BF8B">
			</frame>
			<prop name="LBL_OBS" type="TL" title="Observaciones generales" width="96%" height="22p" font-size="10" fontbold="true" lines="1" lmargin="3%" newline="false" align="center|left"/>
		</frame>
		<!--  Lista de observaciones (verificador / contratista)  -->
		<prop name="@Observaciones" content="contentObs" type="Z" tmargin="10p"/>
		<content name="contentObs" src="collObservaciones" filter="OPO.COD_PPI_CABECERA = '##FLD_COD_PPI_CABECERA##' AND OPO.NUMERO_OBRA = ##FLD_NUMERO_OBRA## ORDER BY OPO.FECHA_CARGA ASC"/>

		<break-page></break-page>
	</coll>

	<!--  ════════════════════════════════════════════════════════════════
         COLECCIÓN OBSERVACIONES — hija de collPPI
         ════════════════════════════════════════════════════════════════  -->
	<coll name="collObservaciones" sql="SELECT 
			CONCAT(
			CASE 
				WHEN OD.COD_ROL = 'PRY' THEN 'Verificador'
				ELSE 'Contratista'
			END,
			' ',
			DATE_FORMAT(OPO.FECHA_CARGA,'%h:%i - %d/%m/%Y')
			) AS ACTOR,       
			OPO.TEXTO AS TEXTO_OBS
			FROM gen_obra_ppi_observaciones OPO
			LEFT JOIN gen_obra_dispositivo OD on OD.BUZON = OPO.BUZON
		  " 
		  show-header="false" cell-odd-bgcolor="#f5f8f3">
		<frame name="frmGeneral" width="96%" tmargin="1%" bmargin="1%" lmargin="2%" rmargin="2%" >
			<prop name="ACTOR" type="T" width="20%" font-size="10" fontbold="true" lines="1" />
			<prop name="TEXTO_OBS" type="T" width="100%" font-size="10" lines="-1" allow-line-breaks="true" />
		</frame>
	</coll>


</xml>