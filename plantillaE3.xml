<?xml version="1.0" encoding="utf-8"?>
<xml>
	<!--  ════════════════════════════════════════════════════════════════
         COLECCIÓN PRINCIPAL — entry-point
         Itera sobre los ítems; cada uno ocupa una página
         ════════════════════════════════════════════════════════════════  -->
	<coll name="collItems" sql="
		  SELECT 
			go.NUMERO_OBRA, 
			go.COD_UBICACION,
			gut.UBICACION_PADRE,
			'[Pendiente Duda] Obra civil / S3020 / S3020-M014K / Celda 2L2p-R0618332' AS JERARQUIA_N1, 
			gut.DESC_UBICACION,
			CONCAT(DATE_FORMAT(go.FECHA_INICIO, '%d-%m-%y'),' / ',DATE_FORMAT(go.FECHA_FIN,'%d-%m-%Y')) as FECHAS,		  
		   '/var/www/vhosts/xoneideintcore.com/core/xonemonitorcore/Monitor/ide_iberdrola.png' AS MAP_LOGO
			FROM gen_obra go
			INNER JOIN gen_uts_ubicaciontecnica gut ON gut.COD_UBICACION = go.COD_UBICACION" filter="go.id=##ID##" entry-point="true" show-header="false" lmargin="5%" rmargin="5%" tmargin="3%" bmargin="5%">
		<!--  ── CABECERA (se repite en todas las páginas) ───────────────  -->
		<frame name="frmCabecera" width="100%" height="68p" copy-to-all-pages="true">
			<!--  Borde izquierdo verde  -->
			<frame name="frmBordeVerde" width="1%" height="68p" bgcolor="#4a7c2f">
			</frame>
			<!--  RESUMEN DE LA OBRA + número  -->
			<frame name="frmDatosHeader" newline="false" height="56p" width="96%" lmargin="3%">
				<frame name="frmDatosObra" width="36%" height="40p" newline="false">
					<prop name="DESCRIPCION_TL" type="TL" title="RESUMEN DE LA OBRA" width="100%" font-size="10" lines="1" forecolor="#777777"/>
					<prop name="NUMERO_OBRA" type="T" width="100%" font-size="16" fontbold="true" lines="1"/>
				</frame>
				<!--  Ubicación técnica + fechas  -->
				<frame name="frmUbicacion" width="38%" height="40p" newline="false">
					<prop name="DESC_UBICACION" type="T" width="100%" font-size="16" fontbold="true" lines="1"/>
					<prop name="FECHAS" type="T" width="100%" font-size="10" forecolor="#555555" lines="1"/>
				</frame>
				<!--  Logo i-DE  -->
				<frame name="frmLogo" width="23%" height="40p" newline="false" align="right">
					<prop name="MAP_LOGO" type="IMG" width="95%" height="58p" keep-aspect-ratio="true" align="right"/>
				</frame>
				<!--  Línea + jerarquía  -->
				<divider width="100%" tmargin="2p"/>
				<frame name="frmJerarquia" width="100%" height="16p" tmargin="10p">
					<prop name="JERARQUIA_N1" type="T" width="100%" font-size="10" forecolor="#444444" fontbold="true" lines="1"/>
				</frame>
			</frame>
		</frame>

		<!--  Lista de observaciones (verificador / contratista)  -->
		<prop name="@items" content="items" type="Z" tmargin="10p"/>
		<content name="items" src="items" filter="gopc.NUMERO_OBRA=##FLD_NUMERO_OBRA## ORDER BY gopc.ID ASC,m.COD_TIPO_PPI_CABECERA ASC, m.id ASC"/>
		
		<footer height="28p">
			<divider width="100%"/>
			<prop name="PIE_IZQUIERDA" type="T" width="80%" font-size="10"  lines="1"  tmargin="10p" fontbold="true"/>
			<prop name="PAGE" type="TL" title="PÁG. ##PAGE## / ##TOTAL_PAGES##" width="20%" font-size="10" fontbold="true" align="right" lines="1" newline="false"  tmargin="10p"/>
		</footer>
	</coll>

	<coll name="items" sql="
		  SELECT
			m.ESPECIFICACION AS ESP_PRO_VALOR,
			m.TIPO_INSPECCION AS INS_TIPO_VALOR,
			ppi.ID AS PPI_ID,
			CONCAT(m.PORCENTAJE_CON, '%') AS CONT_PORCENTAJE_VALOR,
			CONCAT(m.PORCENTAJE_VER, '%') AS VER_PORCENTAJE_VALOR,
			m.COD_CI_CON AS CONT_CLAVE_VALOR,
			m.COD_CI_VER AS VER_CLAVE_VALOR,
			ppi.ESTADO_ITEM AS CONT_ESTADO_VALOR,
			ppi.ESTADO_CON AS VER_ESTADO_VALOR,
			DATE_FORMAT(ppi.FECHA_CON,'%d-%m-%Y') AS CONT_FECHA_VALOR,
			DATE_FORMAT(ppi.FECHA_VER,'%d-%m-%Y') AS VER_FECHA_VALOR,
			--    Documentos ¿?¿?¿?¿
		-- Equipos medida ?¿?¿?¿
		-- Protocolos ?¿?¿?¿?
			ppi.OBSERVACIONES_CON AS CONT_OBS_VALOR,
			ppi.OBSERVACIONES_VER AS VER_OBS_VALOR,
			gopc.id,m.id,
	CAST(CONCAT(DENSE_RANK() OVER (ORDER BY gopc.ID),
	'. Item ',DENSE_RANK() OVER (PARTITION BY gopc.ID ORDER BY m.id)) AS VARCHAR(255)) AS TITULO_ITEM
		FROM gen_obra_ppi_cabecera gopc
		INNER JOIN gen_maestro_obra_tipo_ppi_item m on
		m.COD_TIPO_PPI_CABECERA = gopc.COD_TIPO_PPI_CABECERA 
		INNER JOIN gen_obra_ppi_item ppi
			ON m.COD_TIPO_PPI_ITEM = ppi.COD_TIPO_PPI_ITEM
			AND ppi.COD_PPI_CABECERA = gopc.COD_PPI_CABECERA "
		  show-header="false" >


		<frame name="frmObsTitulo" width="100%" height="22p" tmargin="20p">
			<frame name="frmBordeVerde" width="1%" height="22p" bgcolor="#A0BF8B">
			</frame>
			<prop name="TITULO_ITEM" type="T" width="96%" height="22p" font-size="10" fontbold="true" lines="1" lmargin="3%" newline="false" align="center|left"/>
		</frame>

		<frame name="frmRowActividad" width="100%" height="28p">
			<prop name="ESP_PRO_TL" type="TL" title="Especificación de procedimiento" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="ESP_PRO_VALOR" type="T" title="" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>
		<frame name="frmRowDescripcion" width="100%" height="28p" bgcolor="#f5f8f3" >
			<prop name="INS_TIPO_TL" type="TL" title="Inspección tipo" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" align="center|left"/>
			<prop name="INS_TIPO_VALOR" type="T" title="" width="49%" height="28p" font-size="10" lines="1" lmargin="1%" newline="false" align="center|left"/>
		</frame>

		<prop name="TITULO_ITEM" type="TL" title="&#183; Puntos de inspección" width="96%" height="22p" font-size="10" fontbold="true" tmargin="20p" lines="1" lmargin="3%" align="center|left"/>					
		<!--  ── CABECERA COLUMNAS CONTRATISTA / VERIFICADOR ─────────────  -->
		<frame name="frmPICols" width="100%" height="24p" bgcolor="#bdd5b1">
			<!--  columna etiqueta vacía  -->
			<prop name="LBL_CONTRATISTA" type="TL" title="Contratista" lmargin="34%" width="33%" height="24p" font-size="10" fontbold="true" lines="1" align="center|left" newline="false"/>
			<prop name="LBL_VERIFICADOR" type="TL" title="Verificador" width="33%" font-size="10" height="24p" fontbold="true" lines="1" align="center|left" newline="false"/>
		</frame>
		<!--  ── FILAS DE PUNTOS DE INSPECCIÓN ───────────────────────────  -->
		<!--  Porcentaje  -->
		<frame name="frmPI_Porc" width="100%" height="15p">
			<prop name="CONT_PORCENTAJE_TL" title="Porcentaje" height="24p" type="TL" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555" align="center|left"/>
			<prop name="CONT_PORCENTAJE_VALOR" height="24p" type="T" width="33%" font-size="10" lines="1" newline="false" align="center|left"/>
			<prop name="VER_PORCENTAJE_VALOR" height="24p" type="T" width="33%" font-size="10" lines="1" newline="false" align="center|left"/>
		</frame>
		<!--  Claves inspección  -->
		<frame name="frmPI_Clave" width="100%" height="15p" bgcolor="#f5f8f3" >
			<prop name="CONT_CLAVE_TL" title="Claves inspección" type="TL" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555" align="center|left"/>
			<prop name="CONT_CLAVE_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
			<prop name="VER_CLAVE_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
		</frame>
		<!--  Estado  -->
		<frame name="frmPI_Estado" width="100%" height="15p" >
			<prop name="CONT_ESTADO_TL" title="Estado" type="TL" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555"/>
			<prop name="CONT_ESTADO_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
			<prop name="VER_ESTADO_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
		</frame>
		<!--  Fecha  -->
		<frame name="frmPI_Fecha" width="100%" height="15p" bgcolor="#f5f8f3" >
			<prop name="CONT_FECHA_TL" type="TL" title="Fecha" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555"/>
			<prop name="CONT_FECHA_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
			<prop name="VER_FECHA_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
		</frame>
		<!--  Documentos  -->
		<frame name="frmPI_Docs" width="100%" height="15p" >
			<prop name="CONT_DOCUMENTOS_TL" title="Documentos" type="TL" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555"/>
			<prop name="CONT_DOCUMENTOS_VALOR" type="T" width="33%" font-size="10" lines="2" allow-line-breaks="true" align="center|left" newline="false"/>
			<prop name="VER_DOCUMENTOS_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
		</frame>
		<!--  Equipos de medida  -->
		<frame name="frmPI_Equipos" width="100%" height="15p" bgcolor="#f5f8f3">
			<prop name="CONT_EQUIPOS_TL" title="Equipos de medida" type="TL" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555"/>
			<prop name="CONT_EQUIPOS_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
			<prop name="VER_EQUIPOS_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
		</frame>
		<!--  Protocolos  -->
		<frame name="frmPI_Prot" width="100%" height="15p">
			<prop name="CONT_PROTOCOLOS_TL" title="Protocolos" type="TL" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555"/>
			<prop name="CONT_PROTOCOLOS_VALOR" type="T" width="33%" font-size="10" lines="1" align="center|left" newline="false"/>
			<prop name="VER_PROTOCOLOS_VALOR" type="T" width="33%" font-size="10" lines="2" allow-line-breaks="true" align="center|left" newline="false"/>
		</frame>
		<!--  Observaciones (altura dinámica)  -->
		<frame name="frmPI_Obs" width="100%" bgcolor="#f5f8f3">
			<prop name="CONT_OBS_TL" type="TL" title="Observaciones" width="33%" font-size="10" lines="1" lmargin="1%" forecolor="#555555"/>
			<prop name="CONT_OBS_VALOR" type="T" width="33%" font-size="10" lines="-1" allow-line-breaks="true" newline="false"/>
			<prop name="VER_OBS_VALOR" type="T" width="33%" font-size="10" lines="-1" allow-line-breaks="true" newline="false"/>
		</frame>
		
		
		<!--  Salto de página entre ítems  -->
		<break-page></break-page>
		
	</coll>
	
</xml>