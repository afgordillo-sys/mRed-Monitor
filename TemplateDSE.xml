<?xml version="1.0" encoding="utf-8"?>
<xml>
	<!-- CABECERA -->
	<coll name="coll1" sql="select CONCAT('  ',O.NUMEROORDEN) AS MAP_NUMEROORDEN,
                CONCAT('  ',O.DESCRIPCION) AS MAP_DESCRIPCION,
                CONCAT('  ',O.OBSERVACIONES) AS MAP_OBSERVACIONES,
                concat('RESUMEN OT - ',O.NUMEROORDEN) AS MAP_TITULO,
                '/var/www/vhosts/xoneideintcore.com/core/xonemonitorcore/Monitor/ide_iberdrola.png' AS MAP_LOGO,
                O.ID as ID,
                O.NUMEROORDEN,
				O.TASK_ID,
                IFNULL(O.PDF_CREADO,0) AS PDF_CREADO,
                O.CLAVE_GRUPO_HR,
                O.CONTADOR_GRUPOS_HR,
                concat('  ', O.CONTADOR_GRUPOS_HR) as MAP_CONTADOR_GRUPO_HR,
                concat('  ', O.CLASE_ORDEN,' - ',CO.DESCRIPCION) AS MAP_CLASE_ORDEN,
                concat('  ', O.CLASE_ACTIVIDAD,' - ',IFNULL(CA.DESCRIPCION,'Sin descripción')) AS MAP_CLASE_ACTIVIDAD,
                concat('  ',ROUND(ifnull(H.HORAS_VIAJE_FINALES,0), 2)) AS MAP_HORAS_DESPLAZAMIENTO,
                concat('  ',ROUND(ifnull(H.HORAS_TRABAJO_FINALES,0),2)) AS MAP_HORAS_INTERVENCION,
                concat('  ',CASE WHEN O.PUESTO_TRABAJO2 IS NULL OR O.PUESTO_TRABAJO2 = '' THEN 'Sin brigada' ELSE O.PUESTO_TRABAJO2 END) as MAP_PUESTO_TRABAJO2,
                concat('  ',CASE WHEN O.CODIGO_EQUIPO IS NULL OR O.CODIGO_EQUIPO = '' THEN 'Sin Equipo' ELSE O.CODIGO_EQUIPO END) as MAP_CODIGO_EQUIPO,
                concat('  ',CASE WHEN O.UBICACION_TECNICA IS NOT NULL THEN concat(O.UBICACION_TECNICA,' - ') ELSE '' END,O.NOMBRE_UBICACION) AS MAP_INSTALACION,
                IFNULL(IFNULL(ct.G3E_FID,ctc.G3E_FID),0) AS MAP_G3E_FID,
                IFNULL(IFNULL(ct.G3E_FNO,ctc.G3E_FNO),0) AS MAP_G3E_FNO,
                'Medios Auxiliares – Opcional' as MAP_TITLE_MEDAUX,
                (select COUNT(1) from gen_uts_mediosauxiliares mea where mea.NUMEROORDEN=O.NUMEROORDEN) AS MAP_VER_MEDIOS_AUX,
                'Operaciones – Opcional' as MAP_TITLE_OPER,
                (select COUNT(1) from gen_uts_operaciones mea where mea.NUMEROORDEN=O.NUMEROORDEN and mea.BAJA=0) AS MAP_VER_OPER,
                'Revisión Inventario – Opcional' as MAP_TITLE_REVINV,
                (select count(*) from gen_cambiosinventario cin WHERE cin.TIPO IS NULL and cin.NUMEROORDEN=O.NUMEROORDEN AND cin.G3E_FID=IFNULL(ct.G3E_FID,ctc.G3E_FID) AND cin.G3E_FNO=IFNULL(ct.G3E_FNO,ctc.G3E_FNO)) AS MAP_CAMBIO_INV,
                'Galería OT – Opcional' as MAP_TITLE_GALERIA,
                (select COUNT(1) from gen_ot_fotos mea where mea.NUMEROORDEN=O.NUMEROORDEN and mea.BAJA=0 and mea.TIPO not in ('EVIDENCIAS_UTS','EVIDENCIAS_PREV_UTS')) AS MAP_VER_GALERIA
            from gen_ot_cabecera O
                LEFT JOIN gen_maestro_clase_orden CO ON CO.CODIGO = O.CLASE_ORDEN
                LEFT JOIN (SELECT SUM(HORAS_VIAJE_FINALES) AS HORAS_VIAJE_FINALES,SUM(HORAS_TRABAJO_FINALES) AS HORAS_TRABAJO_FINALES,NUMEROORDEN from gen_ot_estados_ex goee WHERE BAJA=0 GROUP BY NUMEROORDEN) H ON H.NUMEROORDEN = O.NUMEROORDEN
                LEFT JOIN gen_maestro_clase_actividad CA ON CA.CODIGO = O.CLASE_ACTIVIDAD
                left outer join gen_ct ct on ct.g3e_fid = O.codigo_ubicacion
                left outer join gen_ctc ctc on ctc.g3e_fid = O.codigo_ubicacion" lmargin="5%" rmargin="5%" tmargin="5%" bmargin="5%"
				filter="O.ID=##ID## AND O.CLASE_ORDEN='DPRN' AND O.CLASE_ACTIVIDAD='DSE' order by O.ID DESC" entry-point="true" show-header="false" show-pagination="true" show-file-date-creation="true">

				<footer height="20p">
					<prop name="MAP_TITLE_FOOTER" type="TL" width="98%" height="15p" title="La revisión se ha realizado según lo indicado en el manual técnico MT 2.04.02" align="center" font-size="10" lines="1" forecolor="#000000" lmargin="1%"/>
				</footer>

				<prop name="MAP_TITULO" type="T" lmargin="8%" tmargin="5p" width="64%" align="center" fontbold="true" font-size="18" copy-to-all-pages="true"/>
				<prop name="MAP_LOGO" 	type="IMG" 	lmargin="19%" width="9%" align="right"  copy-to-all-pages="true" newline="false" keep-aspect-ratio="true"/>

				<frame name="frmDatosIdentificativos" width="100%" border-color="#000000" tmargin="15p">

					<frame name="frmTITLE_DATOS_IDENTIFICACION" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
						<prop name="MAP_TITLE_DATOS_IDENTIFICACION" type="TL" width="98%" height="15p" title="Datos identificativos" align="center"
							  bgcolor="#00000000" font-size="10" lines="1" fontbold="true" border-color="#000000" forecolor="#ffffff" lmargin="1%"/>
					</frame>

					<prop name="MAP_TL_NUMEROORDEN" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Numero de OT:  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
					<prop name="MAP_NUMEROORDEN" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

					<prop name="MAP_TL_CLASE_ORDEN" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Clase de Orden: " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
					<prop name="MAP_CLASE_ORDEN" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1" newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

					<prop name="MAP_TL_CLASE_ACTIVIDAD" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Clase de Actividad: " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000"/>
					<prop name="MAP_CLASE_ACTIVIDAD" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1" newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000"/>

					<prop name="MAP_TL_INSTALACION" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Instalación: " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000"/>
					<prop name="MAP_INSTALACION" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1" newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000"/>

					<prop name="MAP_TL_PUESTO_TRABAJO2" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Brigada: " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000"/>
					<prop name="MAP_PUESTO_TRABAJO2" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1" newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000"/>

					<prop name="MAP_TL_CODIGO_EQUIPO" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Equipo: " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000"/>
					<prop name="MAP_CODIGO_EQUIPO" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1" newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000"/>

				</frame>

                <frame name="frmDatosGenerales" width="100%" tmargin="15p">
					<frame name="frmTITLE_DATOS_GENERALES" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
						<prop name="MAP_TITLE_DATOS_GENERALES" type="TL" width="98%" height="15p" title="Datos Generales" align="center"
							  bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
					</frame>

				</frame>

				<prop name="MAP_HOJAS_RUTA" content="@HojasRuta" type="Z" />
				<content name="@HojasRuta" src="HojasRuta" filter="COD_HR='##FLD_CLAVE_GRUPO_HR##' AND CONT_HR='##FLD_CONTADOR_GRUPOS_HR##' AND IFNULL(SUBOPERACION,0) &gt; 0 ORDER BY IFNULL(SUBOPERACION,0) ASC"/>

                <prop name="MAP_TL_CONTADOR_GRUPO_HR" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Contador: " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000"/>
				<prop name="MAP_CONTADOR_GRUPO_HR" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1" newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000"/>

				<prop name="MAP_HR" type="TL" title=" " width="100%" height="2p" bgcolor="#000000" lines="1" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" text-border-top="true" text-border-color="#000000"/>

				<prop name="MAP_TITLE_NOTIFICACION" border="true" text-border-left="true" text-border-bottom="true" type="TL" title="  Notificación" width="13%" height="15p" align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000"/>
				<prop name="MAP_TL_HORAS_DESPLAZAMIENTO" border="true" text-border-left="true" text-border-bottom="true" type="TL" title="  Horas Desplazamiento " width="23%" height="15p" align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" newline="false"/>
				<prop name="MAP_HORAS_DESPLAZAMIENTO" border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="64%" height="15p"  align="left" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" newline="false"/>

				<prop name="MAP_TITLE_NOTIFICACION_VACIO" border="true" text-border-left="true" text-border-bottom="true" type="TL" title=" " width="13%" height="15p" align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000"/>
				<prop name="MAP_TL_HORAS_INTERVENCION" border="true" text-border-left="true" text-border-bottom="true" type="TL" title="  Horas Intervencion " width="23%" height="15p" align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" newline="false"/>
				<prop name="MAP_HORAS_INTERVENCION" border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="64%" height="15p"  align="left" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" newline="false"/>

                <break-page />
                <!-- Medios auxiliares -->
                <frame name="frmMediosAuxiliares" width="100%" tmargin="15p" >
					<frame name="frmMEDAUX"  border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
						<prop name="MAP_TITLE_MEDAUX" type="T" width="98%" height="15p" align="center"
							  bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
					</frame>
				</frame>

				<prop name="MAP_LITERAL_MEDAUX" disablevisible="MAP_VER_MEDIOS_AUX&gt;0" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Sin medios auxiliares  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

				<prop name="MAP_MEDIOS_AUXILIARES" content="@MediosAuxiliares" disablevisible="MAP_VER_MEDIOS_AUX=0" type="Z"/>
				<content name="@MediosAuxiliares" src="MediosAuxiliares" filter="mea.NUMEROORDEN='##FLD_NUMEROORDEN##'"/>

                <break-page />
                <!-- Operaciones -->
                <frame name="frmOperaciones" width="100%" tmargin="15p" >
					<frame name="frmOPER"  border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
						<prop name="MAP_TITLE_OPER" type="T" width="98%" height="15p" align="center"
							  bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
					</frame>
				</frame>

				<prop name="MAP_LITERAL_OPER" disablevisible="MAP_VER_OPER&gt;0" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Sin Operaciones  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

				<prop name="MAP_MEDIOS_OPER" content="@Operaciones" disablevisible="MAP_VER_OPER=0" type="Z"/>
				<content name="@Operaciones" src="Operaciones" filter="mea.NUMEROORDEN='##FLD_NUMEROORDEN##' AND mea.BAJA=0"/>

                <break-page />
                <!-- Revisión Inventario -->
                <frame name="frmREVINV" width="100%" tmargin="15p" disablevisible="MAP_CAMBIO_INV&gt;0">
					<frame name="frmTITLE_REVINV" disablevisible="MAP_CAMBIO_INV&gt;0" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
						<prop name="MAP_TITLE_REVINV" disablevisible="MAP_CAMBIO_INV&gt;0" type="T" width="98%" height="15p" align="center"
							  bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
					</frame>
				</frame>

				<prop name="MAP_LITERAL_REVINV" disablevisible="MAP_CAMBIO_INV&gt;0" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Sin cambios" width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

				<prop name="MAP_INVENTARIO" content="@Inventario"  type="Z" disablevisible="MAP_CAMBIO_INV&gt;0"/>
				<content name="@Inventario" src="Inventario" filter="cin.TIPO IS NULL and cin.NUMEROORDEN='##FLD_NUMEROORDEN##' AND cin.G3E_FID=##FLD_MAP_G3E_FID## AND cin.G3E_FNO=##FLD_MAP_G3E_FNO##"/>

                <break-page />
                <!-- Galeria -->
                <frame name="frmGaleria" width="100%" tmargin="15p" >
					<frame name="frmGALERIA"  border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
						<prop name="MAP_TITLE_GALERIA" type="T" width="98%" height="15p" align="center"
							  bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
					</frame>
				</frame>

				<prop name="MAP_LITERAL_GALERIA" disablevisible="MAP_VER_GALERIA&gt;0" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Sin Fotos  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

                <prop name="MAP_GALERIA" disablevisible="MAP_VER_GALERIA=0" grid-column="4" viewmode="grid" content="@Galeria"  type="Z"/>
                <content name="@Galeria" src="FotosOt" filter="F.NUMEROORDEN='##FLD_NUMEROORDEN##' AND F.CLAVE_MODELO is null AND F.TIPO not in ('EVIDENCIAS_UTS','EVIDENCIAS_PREV_UTS') AND F.BAJA=0 and substring_index(lower(F.NOMBRE_FICHERO),'.',-1) in ('png','jpg','jpeg')"/>

</coll>

    <coll name="HojasRuta" sql="SELECT
						CASE WHEN (@i := @i + 1) % 2 = 0 THEN '#FFFFFF' ELSE '#e3eadf' end MAP_BACKGROUND_COLOR,
						case when @i = 1 then '  Hoja de ruta' else '' end MAP_TITLE,
						concat('  Paso ',@i) as MAP_PASO,
						concat('  ', r.DESCRIPCION) as DESCRIPCION
						FROM gen_operacioneshr  r
						cross join (select @i := 0) r"
						lmargin="10p" rmargin="10p" tmargin="10p" filter="" show-header="false">

			<prop name="MAP_TITLE" border="true" text-border-left="true" text-border-bottom="true" type="T" width="13%" height="15p" align="center" bgcolor="##FLD_MAP_BACKGROUND_COLOR##" lines="1" font-size="9" text-border-color="#000000"/>
			<prop name="MAP_PASO" border="true" text-border-left="true" text-border-bottom="true" type="T" width="23%" height="15p" align="center" bgcolor="##FLD_MAP_BACKGROUND_COLOR##" lines="1" font-size="9" text-border-color="#000000" newline="false"/>
			<prop name="DESCRIPCION" border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="64%" height="15p"  align="left" bgcolor="##FLD_MAP_BACKGROUND_COLOR##" lines="1" font-size="9" text-border-color="#000000" newline="false"/>

	</coll>

    <!-- Medios auxiliares -->

    <coll name="MediosAuxiliares" sql="SELECT
	'Medio auxiliar' AS MAP_TITLE_MEDAUX,
	CONCAT('  ',mea.AP_MED_AUX) AS MAP_AP_MED_AUX,
	CONCAT('  ',mea.DESCRIPCION) AS MAP_DESCRIPCION
	FROM gen_uts_mediosauxiliares mea"
					lmargin="10p" rmargin="10p" tmargin="10p" filter="" show-header="false">

		<frame name="frmMEDAUX" width="100%" tmargin="15p">
			<frame name="frmTITLE_MEDAUX" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
				<prop name="MAP_TITLE_MEDAUX" type="T" width="98%" height="15p" align="center"
						bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
			</frame>
		</frame>

		<prop name="MAP_TL_AP_MED_AUX" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Medio auxiliar  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_AP_MED_AUX" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_DESCRIPCION" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Descripción  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_DESCRIPCION" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

	</coll>

    <!-- Operaciones -->

    <coll name="Operaciones" sql="SELECT
        'Operacion' AS MAP_TITLE_OPER,
        mea.NUMEROORDEN,
        mea.EQUIPO,
		mea.CLAVE_MODELO,
		replace(mea.CLAVE_MODELO,'#','') as MAP_CLAVE_MODELO_2,
        CONCAT('  ',mea.CLAVE_MODELO) AS MAP_CLAVE_MODELO,
        CONCAT('  ',mea.TEXTO_CLAVE_MODELO) AS MAP_TEXTO_CLAVE_MODELO,
        CONCAT('  ',mea.EQUIPO) AS MAP_EQUIPO,
        CONCAT('  ',mea.STATUS) AS MAP_STATUS,
        CONCAT('  ',CASE WHEN mea.CLAVE_MODELO LIKE '%#' THEN 'Si' ELSE 'No' END) AS MAP_INFORME_ADICIONAL,
		(SELECT COUNT(1) from gen_uts_medicionequipos m WHERE m.NUMEROORDEN=mea.NUMEROORDEN AND m.POSICION_MEDIDA LIKE CONCAT(replace(mea.CLAVE_MODELO,'#',''),'%') AND m.BAJA=0) as MAP_NUM_MEDICIONES_EQUIPO,
        (SELECT COUNT(1) from gen_ot_fotos F where F.NUMEROORDEN=mea.NUMEROORDEN AND F.TIPO='EVIDENCIAS_PREV_UTS' AND F.BAJA=0 AND F.CLAVE_MODELO=mea.CLAVE_MODELO) AS MAP_NUM_FOTOS_PREV,
        (SELECT COUNT(1) from gen_ot_fotos F where F.NUMEROORDEN=mea.NUMEROORDEN AND F.TIPO='EVIDENCIAS_UTS' AND F.BAJA=0 AND F.CLAVE_MODELO=mea.CLAVE_MODELO) AS MAP_NUM_FOTOS_FIN
        from gen_uts_operaciones mea"
					lmargin="10p" rmargin="10p" tmargin="10p" filter="" show-header="false">

		<frame name="frmOPER" width="100%" tmargin="15p">
			<frame name="frmTITLE_OPER" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
				<prop name="MAP_TITLE_OPER" type="T" width="98%" height="15p" align="center"
						bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
			</frame>
		</frame>

		<prop name="MAP_TL_CLAVE_MODELO" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Clave Modelo  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_CLAVE_MODELO" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_TEXTO_CLAVE_MODELO" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Descripción  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_TEXTO_CLAVE_MODELO" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_EQUIPO" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Código equipo  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_EQUIPO" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_STATUS" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Estado  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_STATUS" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_INFORME_ADICIONAL" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Informe adicional  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_INFORME_ADICIONAL" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

        <!-- mediciones -->
        <prop name="MAP_TL_MEDICIONES_EQUIPO" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Mediciones equipo  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />
        <prop name="MAP_TL_MEDICIONES_EQUIPO_SIN_VAL" disablevisible="MAP_NUM_MEDICIONES_EQUIPO&gt;0" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Sin mediciones  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

        <prop name="MAP_MEDICIONES_EQUIPO" content="@medicionesEquipoUTS" disablevisible="MAP_NUM_MEDICIONES_EQUIPO=0" type="Z"/>
        <content name="@medicionesEquipoUTS" src="medicionesEquipoUTS" filter="mea.NUMEROORDEN='##FLD_NUMEROORDEN##' AND mea.POSICION_MEDIDA LIKE '##FLD_MAP_CLAVE_MODELO_2##%' AND mea.BAJA=0"/>

        <!-- Fotos previas -->
        <prop name="MAP_TL_EVICENCIAS_PREV" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Evidencias previas  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />
		<prop name="MAP_TL_EVICENCIAS_PREV_SIN_VAL" disablevisible="MAP_NUM_FOTOS_PREV&gt;0" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Sin fotos  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

		<prop name="MAP_EVICENCIAS_PREV" disablevisible="MAP_NUM_FOTOS_PREV=0" grid-column="4" viewmode="grid" content="@FotosOtPrev"  type="Z"/>
		<content name="@FotosOtPrev" src="FotosOt" filter="F.NUMEROORDEN='##FLD_NUMEROORDEN##' AND F.TIPO='EVIDENCIAS_PREV_UTS' AND F.BAJA=0 AND F.CLAVE_MODELO='##FLD_CLAVE_MODELO##' and substring_index(lower(F.NOMBRE_FICHERO),'.',-1) in ('png','jpg','jpeg')"/>
        <!-- Fotos fin trabajo -->
        <prop name="MAP_TL_EVICENCIAS_FIN" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Evidencias fin trabajo  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />
		<prop name="MAP_TL_EVICENCIAS_FIN_SIN_VAL" disablevisible="MAP_NUM_FOTOS_FIN&gt;0" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="TL" title="  Sin fotos  " width="100%" height="15p"	align="left" lines="1" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

		<prop name="MAP_EVICENCIAS_FIN" disablevisible="MAP_NUM_FOTOS_FIN=0" grid-column="4" viewmode="grid" content="@FotosOtFin"  type="Z"/>
		<content name="@FotosOtFin" src="FotosOt" filter="F.NUMEROORDEN='##FLD_NUMEROORDEN##' AND F.TIPO='EVIDENCIAS_UTS' AND F.BAJA=0 AND F.CLAVE_MODELO='##FLD_CLAVE_MODELO##' and substring_index(lower(F.NOMBRE_FICHERO),'.',-1) in ('png','jpg','jpeg')"/>
	</coll>

    <!-- Mediciones equipo -->

    <coll name="medicionesEquipoUTS" sql="SELECT
            'Medicion equipo' AS MAP_TITLE_MEDEQ,
            CONCAT('  ',mea.POSICION_MEDIDA) AS MAP_POSICION_MEDIDA,
            CONCAT('  ',mea.VAL_MODIFICADO) AS MAP_VAL_MODIFICADO,
            CONCAT('  ',mea.PUNTO_MEDIDA) AS MAP_PUNTO_MEDIDA,
            CONCAT('  ',CASE
                WHEN mea.DIA_MEDICION LIKE '%-%'
                THEN mea.DIA_MEDICION
                ELSE CONCAT(SUBSTR(mea.DIA_MEDICION,1,4),'-',SUBSTR(mea.DIA_MEDICION,5,2),'-',SUBSTR(mea.DIA_MEDICION,7,2))
            END
            ) AS MAP_FECHA_MED,
            CONCAT('  ',CASE
                WHEN mea.HORA_MEDICION LIKE '%:%'
                THEN mea.HORA_MEDICION
                ELSE CONCAT(SUBSTR(mea.HORA_MEDICION,1,2),':',SUBSTR(mea.HORA_MEDICION,3,2),':',SUBSTR(mea.HORA_MEDICION,5,2))
            END
            ) AS MAP_HORA_MED
            from gen_uts_medicionequipos mea"
					lmargin="10p" rmargin="10p" tmargin="10p" filter="" show-header="false">

		<frame name="frmMEDEQ" width="100%" tmargin="15p">
			<frame name="frmTITLE_MEDEQ" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
				<prop name="MAP_TITLE_MEDEQ" type="T" width="98%" height="15p" align="center"
						bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
			</frame>
		</frame>

		<prop name="MAP_TL_POSICION_MEDIDA" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Posición medida  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_POSICION_MEDIDA" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_VAL_MODIFICADO" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Valor  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_VAL_MODIFICADO" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_PUNTO_MEDIDA" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Punto medida  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_PUNTO_MEDIDA" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_FECHA_MED" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Fecha medición  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_FECHA_MED" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_HORA_MED" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Hora medición  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="MAP_HORA_MED" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />


	</coll>

    <!-- Revisión Inventario -->

    <coll name="Inventario" sql="SELECT
							CONCAT('  ',ATTR) AS ATTR,
							CONCAT('  ',VALOR) AS VALOR,
							CONCAT('  ',VALOR_ANT) AS VALOR_ANT,
							'Revisión Inventario – Opcional' as MAP_TITLE_REVINV
							from gen_cambiosinventario cin"
						lmargin="10p" rmargin="10p" tmargin="10p" filter="" show-header="false">

		<frame name="frmREVINV" width="100%" tmargin="15p">
			<frame name="frmTITLE_REVINV" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" width="100%" bgcolor="#7b9c66">
				<prop name="MAP_TITLE_REVINV" type="T" width="98%" height="15p" align="center"
					  bgcolor="#00000000" font-size="10" lines="1" fontbold="true" forecolor="#ffffff" border-color="#000000" lmargin="1%"/>
			</frame>
		</frame>

		<prop name="MAP_TL_ATTR" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Nombre del campo  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="ATTR" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_VALOR_ANT" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Valor Anterior  " align="center" bgcolor="#ffffff" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="VALOR_ANT" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#ffffff" font-size="9" text-border-color="#000000" />

		<prop name="MAP_TL_VALOR" text-border="true" text-border-left="true" text-border-bottom="true" type="TL" width="30%" height="15p"	title="  Nuevo Valor  " align="center" bgcolor="#e3eadf" lines="1" font-size="9" text-border-color="#000000" />
		<prop name="VALOR" text-border="true" text-border-left="true" text-border-bottom="true" text-border-right="true" type="T" width="70%" height="15p"	align="left" lines="1"  newline="false" bgcolor="#e3eadf" font-size="9" text-border-color="#000000" />

	</coll>

    <!-- Fotos Ot -->
    <coll name="FotosOt" sql="SELECT concat('/var/www/vhosts/xoneideintcore.com/xonerepository/ReplicaFiles/1KEGG99N/',NOMBRE_FICHERO) as MAP_TER_IMG FROM gen_ot_fotos F"
						lmargin="10p" rmargin="10p" tmargin="10p" filter="" show-header="false">

		<frame name="frmIMAGEN" width="100%"  height="100p" align="center" border="true" border-left="true" border-bottom="true" border-right="true" border-top="true" border-color="#000000" bgcolor="#e3eadf">
			<prop name="MAP_TER_IMG" type="IMG" width="98%" height="96p" keep-aspect-ratio="true" must-exist="true"/>
		</frame>
	</coll>

</xml>
